# --- Trilium backend (server-side only; never sent to MCP clients) -----------
TRILIUM_API_URL=https://trilium.example.net/etapi
TRILIUM_API_TOKEN=replace-with-an-etapi-token
# TRILIUM_API_TIMEOUT_MS=30000
# TRILIUM_API_RETRIES=2

# --- stdio entry point (local agents) ----------------------------------------
# Scopes granted to the local process. Legacy PERMISSIONS=READ;WRITE also works.
# TRILIUM_MCP_SCOPES=trilium.read trilium.write

# --- HTTP entry point (cloud agents) -----------------------------------------
# MCP_HTTP_HOST=127.0.0.1          # bind address; 0.0.0.0 inside containers
# MCP_HTTP_PORT=3939
# MCP_HTTP_PATH=/mcp
# MCP_PUBLIC_URL=https://mcp.example.net/trilium/mcp   # externally visible endpoint (required for oidc)
# MCP_ALLOWED_HOSTS=mcp.example.net                    # Host header allow-list when not on loopback
# MCP_TRUST_PROXY=false                                # use X-Forwarded-For for rate limiting keys

# Auth mode: none (loopback only), static (dev tokens), oidc (production)
# MCP_AUTH_MODE=oidc
# MCP_STATIC_TOKENS=dev@some-long-random-token:trilium.read+trilium.write
# MCP_OIDC_ISSUER=https://your-tenant.us.auth0.com/
# MCP_OIDC_AUDIENCE=https://mcp.example.net/trilium/mcp  # defaults to MCP_PUBLIC_URL
# MCP_OIDC_JWKS_URL=                                     # defaults to <issuer>/.well-known/jwks.json
# MCP_OIDC_SCOPE_CLAIMS=scope,permissions,scp

# Limits
# MCP_RATE_LIMIT_PER_MINUTE=120
# MCP_RATE_LIMIT_BURST=30
# MCP_MAX_BODY_BYTES=4194304
# MCP_MAX_WRITE_CONTENT_BYTES=2097152
# MCP_DEFAULT_READ_CONTENT_BYTES=262144
# MCP_MAX_READ_CONTENT_BYTES=4194304

# Logging (stderr, JSON lines) and audit
# LOG_LEVEL=info
# LOG_FORMAT=json
# MCP_AUDIT_ENABLED=true
# MCP_AUDIT_LOG_PATH=/var/log/trilium-mcp/audit.jsonl
